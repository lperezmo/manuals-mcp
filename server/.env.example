# Supabase project (Project Settings > API). The publishable key is safe to
# expose; the server never needs the secret key.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public origin of this server, e.g. https://manuals-mcp.vercel.app.
# Optional: derived from each request when unset.
PUBLIC_URL=

# The manual reader: Muse Spark, or any OpenAI-compatible chat completions API.
# Without it, manuals are still saved and searchable but get no schedule or facts.
READER_BASE_URL=
READER_MODEL=
READER_API_KEY=
# Cost guards: most manual text sent per read, and most reads per household a day.
READER_MAX_CHARS=40000
READER_DAILY_LIMIT=10
# Optional: a different model for the website's chat (same API as the reader).
CHAT_MODEL=
# Most chat questions per household a day (default 100).
CHAT_DAILY_LIMIT=100
# Most label photos read per household a day (default 20).
SNAP_DAILY_LIMIT=20
# Most model calls (reads, chats, photos) across all households a day (default 400).
GLOBAL_DAILY_LIMIT=400

# Optional: push "Report an issue" to your phone with ntfy (https://ntfy.sh).
# Pick a long, unguessable topic name and subscribe to it in the ntfy app.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh

# Optional: web search so the website can find manual PDFs by brand and model.
# Tavily (https://app.tavily.com), free plan ~1,000 searches a month.
SEARCH_API_KEY=
# Most manual searches per household a day (default 20).
SEARCH_DAILY_LIMIT=20
