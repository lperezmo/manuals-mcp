{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && bun install --frozen-lockfile",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "cleanUrls": true,
  "functions": {
    "api/ingest.ts": {
      "maxDuration": 300
    },
    "api/mcp.ts": {
      "maxDuration": 150
    },
    "api/chat.ts": {
      "maxDuration": 300
    },
    "api/tool.ts": {
      "maxDuration": 150
    },
    "api/snap.ts": {
      "maxDuration": 60
    },
    "api/receipt.ts": {
      "maxDuration": 60
    },
    "api/starters.ts": {
      "maxDuration": 60
    },
    "api/find-manual.ts": {
      "maxDuration": 60
    },
    "api/attach.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth-protected-resource"
    }
  ]
}
